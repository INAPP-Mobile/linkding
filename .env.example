# Linkding on Railway — environment variables
#
# Copy to .env when running locally. On Railway these are set on the
# service; LD_SUPERUSER_PASSWORD is the one deploy-form field and is
# generated for you.

# Admin account created automatically on first boot (username is baked
# in as `admin` by the wrapper image).
LD_SUPERUSER_NAME=admin
LD_SUPERUSER_PASSWORD=your-generated-admin-password

# Port the app listens on. Railway injects PORT; the wrapper maps it to
# LD_SERVER_PORT on every boot. Only set manually for local runs.
LD_SERVER_PORT=9090

# Trusted origin for Django CSRF checks. The wrapper derives this from
# the live Railway public domain on every boot; set it manually only
# for a custom domain.
LD_CSRF_TRUSTED_ORIGINS=https://your-linkding-domain.up.railway.app

# Favicon provider used when favicons are enabled in user settings.
# Default is a Google service; DuckDuckGo is the privacy-friendly
# alternative documented upstream.
LD_FAVICON_PROVIDER=https://icons.duckduckgo.com/ip3/{domain}.ico

# Background tasks (scraping titles/descriptions, snapshots). Default
# False = enabled. Set True to disable if they cause trouble.
LD_DISABLE_BACKGROUND_TASKS=False
